# Model Plugin Manifest Template (schema version 2)
# Copy this to plugin.yaml and fill in your information. Unknown keys are rejected.

schema_version: 2
plugin_name: "your_model_plugin_name"  # lower case: ^[a-z][a-z0-9_]*$
version: "1.0.0"                       # Semantic Versioning 2.0.0
author: "Your Name"
description: "Brief description of your model plugin"
license: "MIT"  # Or your preferred license
homepage: "https://github.com/yourusername/your-plugin"  # Optional

# Version requirements (PEP 440 specifiers; each is optional)
requirements:
  milia: ">=1.19.0"
  python: ">=3.10"
  torch_geometric: ">=2.6"

# Python package dependencies: PEP 508 requirements on distribution names (optional)
dependencies: []
  # - "torch>=2.4.0"

# Model declarations
models:
  - name: "YourModelName"
    class: "model:YourModelClass"     # "<module>:<Class>"; model.py inside this plugin directory
    category: "general"               # a category of MILIA's model registry
    description: "What does this model do / what task is it for?"
    # supported_tasks: ["graph_regression"]   # omit to infer them from the class
