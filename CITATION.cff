identifiers:
  - type: doi
    value: "10.5281/zenodo.20151553"
    description: "Concept DOI — always resolves to the latest MILIA release"
  - type: doi
    value: "10.5281/zenodo.22713567"
    description: "Version DOI — MILIA v1.5.0"

