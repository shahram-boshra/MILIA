# =============================================================================
# MILIA — .dockerignore
# =============================================================================
# Excludes files from the Docker build context BEFORE `COPY . /app` runs.
# Rationale: without this file, `COPY . /app` copies the entire working tree —
# including the host's build artifacts — into the image. The recursive project
# listing showed a host-side `milia_pipeline.egg-info/` at the repo root; baking
# that stale metadata (plus `build/`, caches, and `.git/`) into /app creates a
# third divergent copy of package state and needlessly busts the COPY layer cache
# on every unrelated file change.
#
# Same pattern syntax as .gitignore. Do NOT exclude files that `pip install .`
# needs at build time: pyproject.toml, setup.py, README.md (project.readme),
# LICENSE (license-files), the milia_pipeline/ package, and configs/.
#
# Refs: Docker Docs — build context & .dockerignore; KDnuggets / OneUptime
#       .dockerignore best practices for Python projects.
# =============================================================================

# ---- Version control ----
.git
.gitignore
.gitattributes

# ---- Python build / packaging artifacts (regenerated by pip install in-image) ----
build/
dist/
sdist/
develop-eggs/
*.egg-info/
*.egg
.eggs/

# ---- Byte-compiled / cache ----
__pycache__/
*.py[cod]
*$py.class
.Python

# ---- Tooling caches ----
.ruff_cache/
.pytest_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- Virtual environments (deps come from conda/mamba in the image) ----
.venv/
venv/
env/
ENV/

# ---- IDE / editor / OS ----
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Local env & secrets (must never enter an image) ----
.env
.env.*
*.pem
*.key

# ---- Logs & scratch ----
*.log
tmp/
.cache/

# ---- Docker meta (not needed inside the image) ----
Dockerfile
.dockerignore

# ---- Docs build output (source docs/ retained; only built output excluded) ----
docs/_build/

# ---- Heavy data not needed in the image (runtime never uses these; ~332 MB) ----
# Keep small text fixtures (test_data/*.csv, *.xyz, *.sdf) that smoke tests may read;
# exclude only the large binary datasets. Mirrors the .gitignore data policy.
test_data/*.npz
test_data/*.pt
test_data/*.tar.gz
test_data/*.h5
archive/
